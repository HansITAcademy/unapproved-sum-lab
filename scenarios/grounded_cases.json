      "source_record_ids": ["CIV-004", "CIV-005"],
      "grounding_note": "The FAR states that a COR may perform delegated monitoring/administration but has no authority to make commitments or changes affecting contract price, quality, quantity, delivery, or other terms, and the COR's delegated authority is not redelegable.",
      "abstraction_disclaimer": "The workflow is synthetic. It abstracts the documented reserved contract-change authority and does not claim the listed local administrative actions are an actual FAR workflow.",
      "workflow_id": "cg03_contract_administration",
      "baseline_delegated_decisions": ["technical_contract_administration"],
      "baseline_approval_evidence": ["cor_designation"],
      "required_approval_paths": [["contracting_officer"]],
      "delegations": [
        {
          "agent_id": "inspection_agent",
          "owner_id": "inspection_owner",
          "owner_role": "technical_monitor",
          "owner_allowed_actions": ["record_performance_variance"]
