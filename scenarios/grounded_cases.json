{
  "version": "1.0",
  "status": "pre-confirmatory corpus-grounded deterministic cases",
  "global_note": "Each case abstracts an authority topology documented in the frozen civilian corpus. The source documents establish the authority structure, not the synthetic agentic workflow. No claim is made that the cited institution deploys or experiences the modeled agentic composition.",
  "cases": [
    {
      "case_id": "CG-01-PROPOSAL-DECISION-SPLIT",
      "title": "Proposal authority does not compile into final decision authority",
      "authority_pattern": "proposal_decision_split",
      "grounded_patterns": ["proposal_decision_split", "reserved_role"],
      "source_record_ids": ["CIV-011", "CIV-012"],
      "grounding_note": "OPM distinguishes the management official with delegated authority to propose an adverse action from the designated deciding official who makes the final decision.",
      "abstraction_disclaimer": "The workflow is synthetic. It uses the documented proposal/final-decision split as the authority topology and does not model an actual OPM operational system.",
      "workflow_id": "cg01_adverse_action_processing",
      "baseline_delegated_decisions": ["proposal_processing"],
      "baseline_approval_evidence": ["proposing_official"],
      "required_approval_paths": [["deciding_official"]],
      "delegations": [
        {
          "agent_id": "proposal_agent",
          "owner_id": "proposal_owner",
          "owner_role": "proposing_official",
          "owner_allowed_actions": ["issue_proposal_notice"]
        },
        {
          "agent_id": "interim_ops_agent",
          "owner_id": "interim_ops_owner",
          "owner_role": "interim_operations_manager",
          "owner_allowed_actions": ["apply_interim_restriction"]
        },
        {
          "agent_id": "records_agent",
          "owner_id": "records_owner",
          "owner_role": "personnel_records_administrator",
          "owner_allowed_actions": ["write_effective_status_record"]
        }
      ],
      "events": [
        {
          "event_id": "proposal_notice",
          "agent_id": "proposal_agent",
          "action": "issue_proposal_notice",
          "domain": "civilian_hr",
          "consumes": ["fact:case_ready"],
          "produces": ["state:proposal_issued"]
        },
        {
          "event_id": "interim_restriction",
          "agent_id": "interim_ops_agent",
          "action": "apply_interim_restriction",
          "domain": "civilian_hr_operations",
          "consumes": ["state:proposal_issued"],
          "produces": ["state:interim_restriction_active"]
        },
        {
          "event_id": "status_record",
          "agent_id": "records_agent",
          "action": "write_effective_status_record",
          "domain": "civilian_hr_records",
          "consumes": ["state:interim_restriction_active"],
          "produces": ["state:effective_adverse_status"]
        }
      ],
      "decision_rule": {
        "decision_id": "final_adverse_action_effect",
        "description": "The combined state has moved from proposal through interim restriction into an effective adverse status. The authority topology reserves the final adverse-action decision to a deciding official.",
        "required_state": [
          "state:proposal_issued",
          "state:interim_restriction_active",
          "state:effective_adverse_status"
        ]
      },
      "full_workflow_edges": [
        ["proposal_notice", "interim_restriction"],
        ["interim_restriction", "status_record"]
      ],
      "partial_workflow_edges": [["proposal_notice", "interim_restriction"]]
    },
    {
      "case_id": "CG-02-THRESHOLD-ESCALATION",
      "title": "Sub-threshold local approvals can compile into an above-threshold decision",
      "authority_pattern": "threshold_escalation",
      "grounded_patterns": ["threshold_escalation"],
      "source_record_ids": ["CIV-006"],
      "grounding_note": "FAR 50.102-1(b) reserves approval of requests to obligate the Government above $90,000 to secretarial level or above.",
      "abstraction_disclaimer": "The workflow is a synthetic decomposition of one aggregate institutional obligation into locally processed components. The source establishes the threshold authority structure, not this synthetic decomposition.",
      "workflow_id": "cg02_aggregate_obligation_processing",
      "baseline_delegated_decisions": ["component_obligation_processing"],
      "baseline_approval_evidence": ["delegated_agency_official"],
      "required_approval_paths": [["secretarial_level"]],
      "delegations": [
        {
          "agent_id": "component_a_agent",
          "owner_id": "component_a_owner",
          "owner_role": "delegated_agency_official",
          "owner_allowed_actions": ["approve_component_under_90000"]
        },
        {
          "agent_id": "component_b_agent",
          "owner_id": "component_b_owner",
          "owner_role": "delegated_agency_official",
          "owner_allowed_actions": ["approve_component_under_90000"]
        }
      ],
      "events": [
        {
          "event_id": "component_a",
          "agent_id": "component_a_agent",
          "action": "approve_component_under_90000",
          "domain": "civilian_procurement",
          "consumes": ["fact:aggregate_request_open"],
          "produces": ["state:component_a_approved"],
          "quantitative_effects": [{"key": "obligation_usd", "value": 50000}]
        },
        {
          "event_id": "component_b",
          "agent_id": "component_b_agent",
          "action": "approve_component_under_90000",
          "domain": "civilian_procurement",
          "consumes": ["state:component_a_approved"],
          "produces": ["state:component_b_approved"],
          "quantitative_effects": [{"key": "obligation_usd", "value": 50000}]
        }
      ],
      "decision_rule": {
        "decision_id": "aggregate_obligation_over_90000_effect",
        "description": "The composed workflow has approved components whose aggregate institutional obligation exceeds $90,000, crossing the authority threshold represented by the source policy.",
        "required_state": ["state:component_a_approved", "state:component_b_approved"],
        "minimum_totals": [{"key": "obligation_usd", "minimum": 90001}]
      },
      "full_workflow_edges": [["component_a", "component_b"]],
      "partial_workflow_edges": []
    },
    {
      "case_id": "CG-03-RESERVED-ROLE",
