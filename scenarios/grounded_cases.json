      },
      "full_workflow_edges": [
        ["performance_variance", "acceptance_recommendation"],
        ["acceptance_recommendation", "delivery_change"]
      ],
      "partial_workflow_edges": [["performance_variance", "acceptance_recommendation"]]
    },
    {
