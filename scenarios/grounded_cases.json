          "agent_id": "acceptance_agent",
          "action": "record_acceptance_recommendation",
          "domain": "contract_acceptance",
          "consumes": ["state:variance_recorded"],
          "produces": ["state:acceptance_condition_changed"]
        },
        {
          "event_id": "delivery_change",
          "agent_id": "schedule_agent",
          "action": "apply_operational_delivery_change",
          "domain": "contract_delivery",
          "consumes": ["state:acceptance_condition_changed"],
          "produces": ["state:delivery_condition_changed"]
        }
      ],
      "decision_rule": {
        "decision_id": "contract_terms_change_effect",
        "description": "The combined state changes acceptance and delivery conditions in a way the experimental policy treats as the functional equivalent of changing contract terms, a decision reserved to the contracting officer in the grounded authority topology.",
        "required_state": [
          "state:variance_recorded",
          "state:acceptance_condition_changed",
          "state:delivery_condition_changed"
